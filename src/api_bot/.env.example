# Copy to .env and fill in. NEVER commit .env (it holds the bot token).
TELEGRAM_BOT_TOKEN=
# Where the forecast pipeline writes its daily file (default: data/forecasts.csv)
FORECASTS_PATH=../pipeline/forecasts.csv
ALERT_CONFIG_PATH=alert_config.json
BOT_DB_PATH=data/bot.db
# A forecast older than this many days is "stale" (API flag; the bot sends nothing)
MAX_AGE_DAYS=1
# Bot: daily alerts are sent after this hour, Cairo time
NOTIFY_HOUR_CAIRO=8
# Language of new users when Telegram does not say: ar or en
BOT_DEFAULT_LANG=ar
# API CORS (comma separated, * = any)
CORS_ORIGINS=*
